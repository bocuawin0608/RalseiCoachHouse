# Copy to runtime-secret.env and replace every placeholder. Never commit the copy.
SPRING_DATASOURCE_URL=jdbc:sqlserver://<host>:1433;databaseName=VeXeDB;encrypt=true;trustServerCertificate=false;
SPRING_DATASOURCE_USERNAME=<database-user>
SPRING_DATASOURCE_PASSWORD=<database-password>
SPRING_DATA_REDIS_HOST=<redis-host>
JWT_SECRET=<jwt-secret>
SEPAY_API_TOKEN=<sepay-token>
GOONG_API_KEY=<goong-api-key>
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM=<from-address>
