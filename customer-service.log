2026-10-16T09:13:36.525+07:00 DEBUG 39442 --- [customer-service] [nio-8082-exec-4] org.hibernate.SQL                        : 
    SELECT
        c.customerId                                   AS customerId,
        c.customerName                                    AS customerName,
        c.phone                                           AS phone,
        c.email                                           AS email,
        c.dob                                             AS dob,
        c.isActive                                        AS isActive,
        c.createdAt                                       AS createdAt,
        c.accountId                                       AS accountId,
        COUNT(pt.passengerTicketId)                       AS totalTrips,
        COALESCE(SUM(pt.totalPrice), 0)                   AS totalSpent,
        MAX(pt.createdAt)                                 AS lastBooking     
    FROM
        customer c     
    LEFT JOIN
        passenger_ticket pt 
            ON pt.customerId = c.customerId     
    WHERE
        (
            ? IS NULL         
            OR LOWER(c.customerName) LIKE LOWER(CONCAT('%', ?, '%'))         
            OR LOWER(ISNULL(c.phone, '')) LIKE LOWER(CONCAT('%', ?, '%'))         
            OR LOWER(ISNULL(c.email, '')) LIKE LOWER(CONCAT('%', ?, '%'))
        )       
        AND (
            ? IS NULL 
            OR c.isActive = ?
        )       
        AND (
            ? IS NULL           
            OR (
                ? = 'registered' 
                AND c.accountId IS NOT NULL
            )           
            OR (
                ? = 'crm' 
                AND c.accountId IS NULL
            )
        )     
    GROUP BY
        c.customerId,
        c.customerName,
        c.phone,
        c.email,
        c.dob,
        c.isActive,
        c.createdAt,
        c.accountId     
    HAVING
        (
            ? IS NULL         
            OR (
                ? = 'never_booked' 
                AND COUNT(pt.passengerTicketId) = 0
            )         
            OR (
                ? = 'inactive_3mo' 
                AND COUNT(pt.passengerTicketId) > 0             
                AND (
                    MAX(pt.createdAt) IS NULL 
                    OR MAX(pt.createdAt) < DATEADD(MONTH, -3, GETDATE())
                )
            )         
            OR (
                ? = 'active' 
                AND COUNT(pt.passengerTicketId) > 0             
                AND (
                    MAX(pt.createdAt) >= DATEADD(MONTH, -3, GETDATE())
                )
            )
        )     
    ORDER BY
        c.customerId DESC 
