# Store the real file at /etc/nhaxetuanmv-jenkins-report.env on the Jenkins
# agent (chmod 600; owned by the jenkins user). Never commit API tokens.
# The token needs Overall/Read, Job/Read, and Run/Read permissions.
JENKINS_API_URL='http://127.0.0.1:8080'
JENKINS_API_USER='jenkins-report-reader'
JENKINS_API_TOKEN='replace-with-jenkins-api-token'

# Optional: point Jenkins to a virtual environment containing requirements.txt.
# REPORT_PYTHON='/opt/nhaxetuanmv-ci-report/.venv/bin/python'
